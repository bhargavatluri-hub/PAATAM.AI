# Copy to .env.local for local development, and set the same variables in your hosting provider.

# Canonical public URL of the site (used for canonical links, sitemap, robots and social previews).
NEXT_PUBLIC_SITE_URL=https://www.paatam.in

# Public enquiry email shown in the contact section, footer and legal pages.
# Leave empty to hide it — nothing is shown rather than a made-up address.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only. Inbox that receives every enquiry-form submission and chatbot lead by email
# (sent via formsubmit.co; the first one triggers a one-time activation email to this address).
LEAD_EMAIL=

# Server-only. HTTPS endpoint that receives each demo/pilot enquiry as a JSON POST
# (e.g. a CRM intake URL, an automation webhook, or your own backend).
# The form needs LEAD_EMAIL or CONTACT_WEBHOOK_URL; without either it tells visitors their enquiry was NOT sent.
CONTACT_WEBHOOK_URL=

# Server-only, optional. Sent as "Authorization: Bearer <value>" to the webhook.
CONTACT_WEBHOOK_SECRET=

# ---- Website chatbot (src/app/api/chat/route.ts) ----
# Server-only. Claude API key from console.anthropic.com. The chat bubble only appears when this is set.
ANTHROPIC_API_KEY=

# Chatbot leads go to LEAD_EMAIL above, and also to CONTACT_WEBHOOK_URL if set.

# Server-only, optional. Claude model for the chatbot. Defaults to claude-opus-5-5.
CHAT_MODEL=
