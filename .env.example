# Copy to .env.local for local development, and set the same variables in your hosting provider.

# Canonical public URL of the site (used for canonical links, sitemap, robots and social previews).
NEXT_PUBLIC_SITE_URL=https://www.paatam.in

# Optional. Overrides the primary enquiry email (otherwise the first of business.emails
# in src/config/site.ts). Shown in the contact section, footer and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only. Resend API key (https://resend.com). Emails each enquiry to the team
# (business.emails in src/config/site.ts) and sends the visitor an acknowledgement.
# The sender's domain must be verified in Resend.
RESEND_API_KEY=

# Optional overrides for enquiry emails.
# ENQUIRY_FROM=Paatam.ai <enquiries@paatam.in>
# ENQUIRY_TO=bhargav@paatam.in,nikitha@paatam.in

# Server-only, optional. HTTPS endpoint that also receives each enquiry as a JSON POST
# (e.g. a CRM intake URL, an automation webhook, or your own backend).
# Without RESEND_API_KEY or this, the form tells visitors their enquiry was NOT sent.
CONTACT_WEBHOOK_URL=

# Server-only, optional. Sent as "Authorization: Bearer <value>" to the webhook.
CONTACT_WEBHOOK_SECRET=
